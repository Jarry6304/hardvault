# HARDVAULT — secrets.toml 範本
#
# 使用步驟：
#   1. cp secrets.toml.example secrets.toml
#   2. 編輯 secrets.toml 填入實際值
#   3. dotnet run（會自動執行 hardvault build）
#
# [secrets] 區段的值會被 AES-256-GCM 加密後燒入 exe
# [config]  區段的值會明文燒入 exe
#
# 規則：
#   - 至少要有一個 KEY（任一區段）
#   - KEY 必須符合 ^[A-Z][A-Z0-9_]*$
#   - 同名 KEY 不能跨區段重複

[secrets]
LINE_TOKEN  = "ey_demo_token_replace_me"
DB_PASSWORD = "demo_password_replace_me"

[config]
SCAN_CRON = "0 0 8 * * *"
PAGE_SIZE = "50"
